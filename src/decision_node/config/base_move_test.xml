<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
        <UpdateOdomBB />
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="BeginUpstair">
          <IsAction value="INIT" />
          <SetAction action="GOTOSTAIR" />
        </Sequence>

        <Sequence name="AlignAtStair">
          <IsAction value="GOTOSTAIR" />
          <CheckArrived />
          <SetAction action="BASE_ALIGN" />
        </Sequence>

        <Sequence name="GoUp">
          <IsAction value="BASE_ALIGN" />
          <CompareYaw />
          <SetAction action="UPSTAIR" />
        </Sequence>

        <Sequence name="ReTurnToNormal">
          <IsAction value="UPSTAIR" />
          <CheckArrived />
          <SetAction action="RETURN_TO_NORMAL" />
        </Sequence>

        <Sequence name="MaintainGoToStair">
          <IsAction value="GOTOSTAIR" />
          <SetAction action="GOTOSTAIR" />
        </Sequence>

        <Sequence name="MaintainBaseAlign">
          <IsAction value="BASE_ALIGN" />
          <SetAction action="BASE_ALIGN" />
        </Sequence>

        <Sequence name="MaintainUpstair">
          <IsAction value="UPSTAIR" />
          <SetAction action="UPSTAIR" />
        </Sequence>

        <Sequence name="MaintainReturnToNormal">
          <IsAction value="RETURN_TO_NORMAL" />
          <SetAction action="RETURN_TO_NORMAL" />
        </Sequence>

        <Sequence name="FallbackToInit">
          <SetAction action="INIT" />
        </Sequence>
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence name="ExecInit">
          <IsAction value="INIT" />
          <SetAction action="GOTOSTAIR" />
        </Sequence>

        <Sequence name="ExecGoToStair">
          <IsAction value="GOTOSTAIR" />
          <SetGoalFromParams ns="go_to_stair" />
          <SetSpinFlag target_spin="0" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishSpin />
        </Sequence>

        <Sequence name="ExecBaseAlign">
          <IsAction value="BASE_ALIGN" />
          <SetSpinFlag target_spin="0" />
          <CalculateAngle />
          <PublishSpin />
          <PublishTargetYaw />
        </Sequence>

        <Sequence name="ExecUpstair">
          <IsAction value="UPSTAIR" />
          <SetGoalFromParams ns="upstair" />
          <SetSpinFlag target_spin="2" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishSpin />
        </Sequence>

        <Sequence name="ExecReturnToNormal">
          <IsAction value="RETURN_TO_NORMAL" />
          <SetGoalFromParams ns="return_to_normal" />
          <SetSpinFlag target_spin="0" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishSpin />
        </Sequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>