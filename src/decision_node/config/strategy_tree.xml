              <Sequence name="StayAtOutpost">
              <IsAction value="ATTACK_OUTPOST" />
              <CheckArrived/>
              <SetAction action="STAY_AT_OUTPOST"/>
              </Sequence>

              <Sequence name="MaintainAttackOutpost">
                <IsAction value="STAY_AT_OUTPOST" />
