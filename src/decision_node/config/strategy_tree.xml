<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="ToInitWhenNotInGame">
          <IsGameStarted expect_started="false" />
          <!-- <ResetCentralOccupiable /> -->
          <SetAction action="INIT" />
        </Sequence>

        <Sequence name="ToPushWhenGameStart">
          <IsGameStarted expect_started="true" />
          <IsAction value="INIT" />
          <SetAction action="PUSH" />
        </Sequence>

        <Sequence name="ToRespawnWhenDead">
          <IsSentryDead />
          <SetAction action="RESPAWN" />
        </Sequence>

        <Sequence name="ToSupplyAfterRespawn">
          <IsAction value="RESPAWN" />
          <IsSentryAlive />
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="ToSupplyWhenInDanger">
          <IsSentryInDanger danger_hp="{danger_hp}" hp_key="ref.remain_hp" />
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="MaintainSupply">
          <IsAction value="SUPPLY" />
          <Inverter>
            <IsHealthFull max_hp="{max_hp}" />
          </Inverter>
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="SwitchPushToOccupy">
          <IsAction value="PUSH" />
          <CheckArrived />
          <SetAction action="OCCUPY" />
        </Sequence>

        <Sequence name="SwitchRadicalToRadical1">
          <IsAction value="RADICAL" />
          <AggressiveAdvantage threshold="50" />
          <Inverter>
            <NotBulletSufficient />
          </Inverter>
          <CheckArrived />
          <SetAction action="RADICAL1" />
        </Sequence>

        <Sequence name="MaintainRadical">
          <IsAction value="RADICAL" />
          <AggressiveAdvantage threshold="50" />
          <Inverter>
            <NotBulletSufficient />
          </Inverter>
          <SetAction action="RADICAL" />
        </Sequence>


        <!-- <Sequence name="SwitchRadical1ToPush">
          <IsAction value="RADICAL1" />
          <CheckArrived />
          <SetAction action="PUSH" />
        </Sequence> -->


        <Sequence name="MaintainRadical1">
          <IsAction value="RADICAL1" />
          <AggressiveAdvantage threshold="50" />
          <Inverter>
            <Fallback>
              <NotBulletSufficient />
              <IsSentryInDanger danger_hp="150" hp_key="ref.remain_hp" />
            </Fallback>
          </Inverter>
          <SetAction action="RADICAL1" />
        </Sequence>

        <Sequence name="ToPush">
          <Inverter>
            <IsAction value="OCCUPY" />
          </Inverter>
          <IsOccupyStatusFavorable /> 
          <SetAction action="PUSH"/>  
        </Sequence>
        
        <Sequence name="ToRadicalWhenAggressiveAndBulletSufficient">
          <AggressiveAdvantage threshold="50" />
          <Inverter>
            <Fallback>
              <NotBulletSufficient />
              <IsSentryInDanger danger_hp="150" hp_key="ref.remain_hp" />
            </Fallback>
          </Inverter>
          <SetAction action="RADICAL" />
        </Sequence>
      
  
        <Sequence name="MaintainOccupy">
          <IsAction value="OCCUPY" />
          <SetAction action="OCCUPY" />
        </Sequence>

        <!-- Default state -->
        <Sequence name="ToWaitforOP">
          <SetAction action="WAITFOROP" />
        </Sequence>
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence>
          <IsAction value="INIT" />
          <!-- <SetMotionFlag target_motion="0" /> -->
          <!-- <PublishMotion /> -->
          <ClearGoal />
        </Sequence>

        <Sequence>
          <IsAction value="PUSH" />
          <!-- Navigate to first cycle point (moving state) -->
          <!-- <SetMotionFlag target_motion="3" /> -->
          <!-- <PublishMotion /> -->
          <SetGoalFromParamsCyclic ns="occupy" point_count="2" />
          <PublishGoalPoint topic="clicked_point" />
          <Sequence>
              <CheckArrived />
              <SetAction action="OCCUPY"/>
              <AlwaysSuccess />
          </Sequence>
        </Sequence>

        <Sequence>
          <IsAction value="OCCUPY" />
          <Fallback>
            <Sequence>
              <CheckArrived />
              <AdvanceCycleIndex point_count="2" /> 
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <!-- <Fallback>
            <Sequence>
              <CheckAttacked attack_threshold="{attack_threshold}" />
              <SetMotionFlag target_motion="2" />
            </Sequence> -->
            <!-- <SetMotionFlag target_motion="1" /> -->
          <!-- </Fallback>  -->
          <!-- <PublishMotion /> -->
          <SetGoalFromParamsCyclic ns="occupy" point_count="2" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetGoalFromParams ns="supply" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        
        <Sequence>
          <IsAction value="RADICAL" />
          <!-- <InitChase /> -->
          <!-- <UpdateChaseTarget /> -->
          <!-- TODO: 接入视觉模块 -->
          <!-- <Fallback>
            <Sequence>
              <CheckAttacked attack_threshold="{attack_threshold}" />
              <SetMotionFlag target_motion="2" />
            </Sequence>
            <SetMotionFlag target_motion="1" />
          </Fallback> -->
          <!-- <PublishMotion /> -->
          <SetGoalFromParams ns="radical" />
          <PublishGoalPoint topic="clicked_point" />
          <!-- <PublishChaseGoal /> -->
        </Sequence>

        <Sequence>
          <IsAction value="RADICAL1" />
          <SetGoalFromParams ns="radical1" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>
      

        <Sequence>
          <IsAction value="RESPAWN" />
        </Sequence>

        <Sequence>
          <IsAction value="WAITFOROP" />
          
          <Fallback>
            <Sequence>
                <IntenseHarm 
                   threshold_activate="{harm_threshold_on}" 
                   threshold_deactivate="{harm_threshold_off}" />
                <SetGoalFromParams ns="retreat" />
            </Sequence>
            <SetGoalFromParams ns="waitforop" />
          </Fallback>

          <PublishGoalPoint topic="clicked_point" />
        </Sequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>