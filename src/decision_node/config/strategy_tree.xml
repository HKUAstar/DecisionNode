      <Sequence name="ResetValue">
        <Fallback>
          <Sequence name="FreeBullet">
            <CheckVision key="ref.supplement" expected="true" />
            <SetBBValue key="count.free_bullet" type="int" value="0" />
          </Sequence>
          <AlwaysSuccess />
        </Fallback>
        <Fallback>
          <Sequence name="Bullet">
            <Inverter>
              <IsAction value="BUY_BULLET" />
            </Inverter>
            <SetBBValue key="bullet_num" type="int" value="0" />
            <PublishBulletNum />
          </Sequence>
          <AlwaysSuccess />
        </Fallback>
        <Fallback>
          <Sequence name="Spin">
            <Inverter>
              <ReactiveFallback>
                <IsAction value="VISION" />
              </ReactiveFallback>
            </Inverter>
            <SetSpinFlag target_spin="0" />
            <PublishSpin />
          </Sequence>
          <AlwaysSuccess />
        </Fallback>
      </Sequence>

      <ReactiveFallback name="SpinSpeedControl">
        <Sequence>
          <IsAction value="DEADSUPPLY" />
          <SetSpinVelo target_spin_velo="0" />
          <PublishSpinVelo />
        </Sequence>
        <Sequence>
          <CheckAttacked/>
          <SetSpinVelo target_spin_velo="2" />
          <Wait duration="2.0" />
          <PublishSpinVelo />
        </Sequence>
        <Sequence>
        <SetSpinVelo target_spin_velo="1" />
        <PublishSpinVelo />
        </Sequence>
