<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="ToInitWhenNotInGame">
          <IsGameStarted expect_started="false" />
          <SetAction action="INIT" />
        </Sequence>

        <Sequence name="ToPushWhenGameStart">
          <IsGameStarted expect_started="true" />
          <IsAction value="INIT" />
          <SetAction action="PUSH" />
        </Sequence>

        <Sequence name="ToRespawnWhenDead">
          <IsSentryDead />
          <SetAction action="RESPAWN" />
        </Sequence>

        <Sequence name="ToSupplyAfterRespawn">
          <IsAction value="RESPAWN" />
          <IsSentryAlive />
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="ToSupplyWhenInDanger">
          <IsSentryInDanger />
          <SetAction action="SUPPLY" />
        </Sequence>


        <Fallback name="ToPush">
          <!-- PUSH: Navigate to the first cycle point -->
          <Sequence name="SafePush">
            <Sequence>
              <AccumulateCentralOccupiable 
                occupy_status="{ref.occupy_status}"
                threshold="{occupy_threshold}"
                accumulated_count="{occupy_count}"
                reached_threshold="{occupy_reached}" />
              <TriggerOnThreshold 
                reached_threshold="{occupy_reached}"
                reset_condition="{is_enemy_occupied}" />
            </Sequence>
            <SetAction action="PUSH" />
            <ResetAccumulator />
          </Sequence>
          
          <!-- OCCUPY: Loop between 4 points -->
          <Fallback name="AggressiveOccupy">
            <Sequence>
              <Fallback>
                <NotBulletSufficient />
                <AggressiveAdvantage threshold="{aggressive_threshold}" />
              </Fallback>
              <SetAction action="PUSH"/>
            </Sequence>
          </Fallback>
        </Fallback>

        <!-- RADICAL Mode: Chase enemy when aggressive and bullet sufficient -->
        <!--
        <Sequence name="ToRadicalWhenAggressiveAndBulletSufficient">
          <AggressiveAdvantage threshold="-999" />
          <Fallback>
            <NotBulletSufficient />
            <AlwaysFailure />
          </Fallback>
          <SetAction action="RADICAL" />
        </Sequence>
        -->

        <!-- WAITFOROP: Default state when no other conditions are met -->
        <Sequence name="ToWaitforOP">
          <SetAction action="WAITFOROP" />
        </Sequence>
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence>
          <IsAction value="INIT" />
          <SetMotionFlag target_motion="3" />
          <PublishMotion />
          <SetBulletUp value="0" />
          <PublishBulletUp />
          <SetRecover value="0" />
          <PublishRecover />
          <ClearGoal />
        </Sequence>

        <Sequence>
          <IsAction value="PUSH" />
          <!-- Navigate to first cycle point (moving state) -->
          <SetMotionFlag target_motion="2" />
          <PublishMotion />
          <SetGoalFromParamsCyclic ns="occupy" point_count="4" />
          <PublishGoalPoint topic="clicked_point" />
          <Sequence>
              <CheckArrived />
              <SetAction action="OCCUPY"/>
              <AlwaysSuccess />
          </Sequence>
        </Sequence>

        <Sequence>
          <IsAction value="OCCUPY" />
          <!-- Loop between 4 points, advancing when arrived -->
          <Fallback>
            <Sequence>
              <CheckArrived />
              <AdvanceCycleIndex point_count="4" /> 
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <!-- Set motion_flag based on attack status while in loop -->
          <Fallback>
            <Sequence>
              <CheckAttacked />
              <SetMotionFlag target_motion="1" />
            </Sequence>
            <SetMotionFlag target_motion="0" />
          </Fallback>
          <PublishMotion />
          <SetGoalFromParamsCyclic ns="occupy" point_count="4" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetMotionFlag target_motion="2" />
          <PublishMotion />
          <SetGoalFromParams ns="supply" />
          <PublishGoalPoint topic="clicked_point" />
          <Fallback>
            <Sequence>
              <CheckArrived />
              <SetRecover value="1" />
              <PublishRecover />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <IsHealthFull />
              <SetRecover value="0" />
              <PublishRecover />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <CheckArrived />
              <SetBulletUp value="1" />
              <PublishBulletUp />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <IsBulletFull max_bullet="999" />
              <SetBulletUp value="0" />
              <PublishBulletUp />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
        </Sequence>

        <!-- RADICAL Mode: Chase enemy execution -->
        <!--
        <Sequence>
          <IsAction value="RADICAL" />
          <SetMotionFlag target_motion="1" />
          <PublishMotion />
          [TODO: Chase/Pursuit node to be implemented here]
        </Sequence>
        -->

        <Sequence>
          <IsAction value="RESPAWN" />
          <SetMotionFlag target_motion="3" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="WAITFOROP" />
          <SetMotionFlag target_motion="0" />
          <PublishMotion />
          <SetBulletUp value="0" />
          <PublishBulletUp />
          <SetRecover value="0" />
          <PublishRecover />
          <SetGoalFromParams ns="waitforop" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
