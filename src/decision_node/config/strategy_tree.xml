          <PublishMotion/>
        </Sequence>

        <Sequence>
        <IsAction value="STAY_AT_FORTRESS"/>
        <SetMotionFlag target_motion="1" />
        <SetSpinFlag target_spin="4" />
        <PublishMotion/>
        <PublishSpin/>
        </Sequence>


        
