<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="ToInitWhenNotInGame">
          <IsGameStarted expect_started="false" />
          <!-- <ResetCentralOccupiable /> -->
          <SetAction action="INIT" />
        </Sequence>


        <Sequence name="ToRespawnWhenDead">
          <IsSentryDead />
          <SetAction action="RESPAWN" />
        </Sequence>

        <Sequence name="ToSupplyAfterRespawn">
          <IsAction value="RESPAWN" />
          <IsSentryAlive />
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="ToSupplyWhenInDanger">
          <IsSentryInDanger danger_hp="{danger_hp}" hp_key="ref.remain_hp" />
          <NotBulletSufficient />
          <SetAction action="SUPPLY" />
        </Sequence>

        <Sequence name="ToSupplyWhenBulletLow">
          <NotBulletSufficient />
          <CheckIntStatus key="ref.bullet_remain" expected="0" />
          <SetAction action="SUPPLY" />
        </Sequence>


        <Sequence name="MaintainSupply">
          <IsAction value="SUPPLY" />
          <Inverter>
            <IsHealthFull max_hp="{max_hp}" />
          </Inverter>
          <SetAction action="SUPPLY" />
        </Sequence>
        
        <Sequence name="DefendRampLaunch">
          <CheckIntStatus key="ref.launch_ramp_elevated_ground" expected="1" />
          <SetAction action="UpStair" />
        </Sequence>

        <!-- Default state -->
        <Sequence name="ToWaitforOP">
          <SetAction action="WAITFOROP" />
        </Sequence>
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence>
          <IsAction value="INIT" />
          <!-- <SetMotionFlag target_motion="0" /> -->
          <!-- <PublishMotion /> -->
          <ClearGoal />
        </Sequence>

       

        

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetGoalFromParams ns="supply" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

      
        
        <Sequence>
          <IsAction value="RADICAL" />
          <!-- <InitChase /> -->
          <!-- <UpdateChaseTarget /> -->
          <!-- TODO: 接入视觉模块 -->
          <!-- <Fallback>
            <Sequence>
              <CheckAttacked attack_threshold="{attack_threshold}" />
              <SetMotionFlag target_motion="2" />
            </Sequence>
            <SetMotionFlag target_motion="1" />
          </Fallback> -->
          <!-- <PublishMotion /> -->
          <SetGoalFromParams ns="radical" />
          <PublishGoalPoint topic="clicked_point" />
          <!-- <PublishChaseGoal /> -->
        </Sequence>

        <Sequence>
          <IsAction value="RADICAL1" />
          <SetGoalFromParams ns="radical1" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>
      

        <Sequence>
          <IsAction value="RESPAWN" />
        </Sequence>

        <Sequence>
          <IsAction value="PATROL" />
          <SetMotionFlag target_motion="2" />
           <Fallback>
            <Sequence>
              <CheckArrived />
              <AdvanceCycleIndex ns="patrol" point_count="2" />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <!-- <Fallback>
            <Sequence>
              <CheckAttacked attack_threshold="{attack_threshold}" />
            </Sequence> -->
            <!-- <SetMotionFlag target_motion="1" /> -->
          <!-- </Fallback>  -->
          <!-- <PublishMotion /> -->
          <SetGoalFromParamsCyclic ns="patrol" point_count="2" />
          <PublishGoalPoint topic="clicked_point" />
          <!-- <Fallback>
            <Sequence>
                <IntenseHarm 
                   threshold_activate="{harm_threshold_on}" 
                   threshold_deactivate="{harm_threshold_off}" />
                <SetGoalFromParams ns="retreat" />
            </Sequence>
            <SetGoalFromParams ns="waitforop" /> -->
          </Fallback>

          <PublishGoalPoint topic="clicked_point" />
        </Sequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>