                <WaitForVision duration="10" key="vision.detected" />
                <Sequence>
                <SetBBValue key="count.enemy_outpost" type="bool" value="false" />
                <AlwaysFailure/>
                </Sequence>
                </ReactiveFallback>
                <SetAction action="STAY_AT_OUTPOST" />
              </Sequence>


              <Sequence name="StopWhenFindEnemy">
                <CheckVision key="vision.detected" expected="true" />
                <Inverter>
                <ReactiveFallback>
                <IsAction value="STAY_AT_FORTRESS"/>
                <IsAction value="STAY_AT_OUTPOST"/>
                </ReactiveFallback>
                </Inverter>
                <SetAction action="VISION" />
              </Sequence>

              <Sequence>
              <Inverter>
