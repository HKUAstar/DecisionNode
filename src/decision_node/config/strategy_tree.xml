<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="ToInitWhenNotInGame">
          <GameNotStartEnd />
          <SetAction action="INIT" />
        </Sequence>

        <Sequence name="ToRespawnWhenDead">
          <IsSentryDead />
          <SetAction action="RESPAWN" />
        </Sequence>

        <Sequence name="ToSupplyWhenInDanger">
          <IsSentryInDanger />
          <SetAction action="SUPPLY" />
        </Sequence>


        <Fallback name="ToOccupy">
          <Sequence>
            <AccumulateCentralOccupiable 
              occupy_status="{ref.occupy_status}"
              threshold="{occupy_threshold}"
              accumulated_count="{occupy_count}"
              reached_threshold="{occupy_reached}" />
            <TriggerOnThreshold 
              reached_threshold="{occupy_reached}"
              reset_condition="{is_enemy_occupied}" />
            <SetAction action="OCCUPY" />
            <ResetAccumulator />
          </Sequence>
          <Sequence>
            <Fallback>
              <NotBulletSufficient />
              <AggressiveAdvantage threshold="{aggressive_threshold}" />
            </Fallback>
            <SetAction action="OCCUPY" />
          </Sequence>
        </Fallback>

        <!-- RADICAL Mode: Chase enemy when aggressive and bullet sufficient -->
        <!--
        <Sequence name="ToRadicalWhenAggressiveAndBulletSufficient">
          <AggressiveAdvantage threshold="-999" />
          <Fallback>
            <NotBulletSufficient />
            <AlwaysFailure />
          </Fallback>
          <SetAction action="RADICAL" />
        </Sequence>
        -->

        <SetAction action="OCCUPY" />
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence>
          <IsAction value="INIT" />
          <SetMotionFlag target_motion="3" />
          <SetMotion input_port="STAY_IN_PLACE" />
          <PublishMotion />
          <ClearGoal />
        </Sequence>

        <Sequence>
          <IsAction value="OCCUPY" />
          <Fallback>
            <Sequence>
              <CheckArrived />
              <AdvanceCycleIndex point_count="4" /> 
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <!-- Enter loop state: set motion_flag to 0 -->
          <SetMotionFlag target_motion="0" />
          <!-- Check if under attack: if yes, set to 1; otherwise try to reset to 0 -->
          <Fallback>
            <Sequence>
              <CheckAttacked />
              <SetMotionFlag target_motion="1" />
            </Sequence>
            <SetMotionFlag target_motion="0" />
          </Fallback>
          <SetMotion input_port="OCCUPY" />
          <PublishMotion />
          <SetGoalFromParamsCyclic ns="occupy" point_count="4" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetMotionFlagToOne />
          <SetMotion input_port="SUPPLY" />
          <PublishMotion />
          <SetGoalFromParams ns="supply" />
          <PublishGoalPoint topic="clicked_point" />
          <Fallback>
            <Sequence>
              <CheckArrived />
              <SetRecover value="1" />
              <PublishRecover />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <IsHealthFull />
              <SetRecover value="0" />
              <PublishRecover />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <CheckArrived />
              <SetBulletUp value="1" />
              <PublishBulletUp />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <IsBulletFull max_bullet="999" />
              <SetBulletUp value="0" />
              <PublishBulletUp />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
        </Sequence>

        <!-- RADICAL Mode: Chase enemy execution -->
        <!--
        <Sequence>
          <IsAction value="RADICAL" />
          <SetMotionFlagToOne />
          <SetMotion input_port="RADICAL" />
          <PublishMotion />
          [TODO: Chase/Pursuit node to be implemented here]
        </Sequence>
        -->

        <Sequence>
          <IsAction value="RESPAWN" />
          <SetMotion input_port="RESPAWN" />
          <PublishMotion />

        <AlwaysFailure/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
