          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetGoalFromParams ns="supply" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="GOTO_BUY" />
          <SetGoalFromParams ns="buy_bullet" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="BUY_BULLET" />
          <SetGoalFromParams ns="buy_bullet" />
          <SetMotionFlag target_motion="3" />
          <SetBulletNum mode="FIXED" fixed_supply="50" />
          <PublishMotion />
          <PublishGoalPoint topic="clicked_point" />
          <PublishBulletNum />
        </Sequence>

        <Sequence>
          <IsAction value="OPERATOR_COMMAND" />
          <SetOperatorGoal />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        <Sequence>
          <IsAction value="VISION" />
          <RecordVisionAnchor />
          <CalculateVisionYaw />
          <ReactiveFallback>
          <Sequence>
            <CheckArrived />
            <SetSpinFlag target_spin="4" />
          </Sequence>
            <AlwaysSuccess />
          </ReactiveFallback>
          <ReactiveFallback>
            <Sequence>
              <CheckVisionAnchorDistance max_distance="1.0" />
              <SetVisionTarget offset_distance="0.4" />
              <Sequence>
                <CheckGoalInZone zone_num="1" />
                <PublishGoalPoint topic="clicked_point" />
                <AlwaysSuccess />
              </Sequence>
              </Sequence>
            <SetAction action="PATROL" />
          </ReactiveFallback>
          <PublishSpin />
        </Sequence>

