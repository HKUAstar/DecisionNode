<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <ReactiveSequence name="MainLoop">
      <Sequence name="UpdateBlackboard">
        <UpdateRefereeBB />
        <UpdateNavigationBB />
        <UpdateVisionBB />
        <UpdateTimersBB />
        <UpdateDerivedFlags danger_hp="{danger_hp}" sufficient_bullet="{sufficient_bullet}" />
        <UpdateOdomBB />
        <UpdateBulletBB/>
      </Sequence>

      <ReactiveFallback name="DecideAction">
        <Sequence name="GameNotStarted">
          <IsGameStarted expect_started="false" />
          <SetAction action="INIT" />
        </Sequence>

        <ReactiveFallback name="InGame">
          <ReactiveFallback name="Dead">
            <Sequence name="Respawn">
              <IsSentryDead />
              <ReactiveFallback>
                <Sequence name="EleDead">
                  <ReactiveFallback name="CheckElePatrol">
                    <IsAction value="ELEVATED_GROUND_PATROL0" />
                    <IsAction value="ELEVATED_GROUND_PATROL1" />
                    <IsAction value="ELEVATED_GROUND_PATROL2" />
                    <IsAction value="ELEVATED_GROUND_PATROL3" />
                  </ReactiveFallback>
                  <SetAction action="ELEDEAD"/>
                </Sequence>
                <SetAction action="RESPAWN" />
              </ReactiveFallback>
            </Sequence>
          </ReactiveFallback>
          
          <ReactiveFallback name="Alive">
            <Sequence name="EleDead">
              <IsAction value="ELEDEAD" />
              <SetAction action="ELEVATED_GROUND_PATROL3" />
            </Sequence>

            <Sequence name="DeadSupply">
              <IsAction value="RESPAWN" />
              <SetAction action="DEADSUPPLY" />
            </Sequence>

            <Sequence name="MaintainDeadSupply">
              <IsAction value="DEADSUPPLY" />
              <Inverter>
                <IsHealthFull max_hp="{max_hp}" />
              </Inverter>
              <SetAction action="DEADSUPPLY" />
            </Sequence>

            <ReactiveFallback name="ChooseSupply">
              <Sequence name="Supply">
                <IsSentryInDanger danger_hp="{danger_hp}" hp_key="ref.remain_hp" />
                <NotBulletSufficient />
                <SetAction action="SUPPLY" />
              </Sequence>
              <Fallback name="SupplyBullet">
                <Sequence name="FreeBullet">
                  <NotBulletSufficient />
                  <Inverter>
                    <CompareValue key="count.free_bullet" threshold="0" />
                  </Inverter>
                  <SetAction action="SUPPLY" />
                </Sequence>
                <Sequence name="BuyBullet">
                  <NotBulletSufficient/>
                  <Inverter>
                    <CompareValue key="ref.remaining_gold_coin" threshold="200" />
                  </Inverter>
                  <SetAction action="GOTO_BUY" />
                </Sequence>
              </Fallback>
            </ReactiveFallback>

            <Sequence name="BuyBullet">
              <IsAction value="GOTO_BUY" />
              <CheckArrived />
              <SetAction action="BUY_BULLET" />
              <Wait duration="2.0" />
            </Sequence>

            <Sequence name="MaintainSupply">
              <IsAction value="SUPPLY" />
              <Inverter>
                <IsHealthFull max_hp="{max_hp}" />
              </Inverter>
              <SetAction action="SUPPLY" />
            </Sequence>
            
            <Sequence name="OperatorCommand">
              <!-- <云台手指令> -->
              <Inverter>
                <IsAction value="OPERATOR_COMMAND" />
              </Inverter>
              <SetAction action="OPERATOR_COMMAND" />
              <ClearCounter counter_key="operator_command_count" />
              <ReactiveFallback>
                <Sequence name="ReturnToOperatorCommand">
                  <IsAction value="DOWNSTAIR" />
                  <CheckArrived />
                  <SetAction action="OPERATOR_COMMAND" />
                </Sequence>
                <Sequence name="DownStairProtection">
                  <IsAction value="ELEVATED_GROUND_PATROL3" />
                  <CheckArrived />
                  <SetAction action="DOWNSTAIR" />
                </Sequence>
                <Sequence >
                  <IsAction value="DOWNSTAIR" />
                  <SetAction action="DOWNSTAIR" />
                  <ReactiveFallback name="CheckElePatrol">
                    <IsAction value="ELEVATED_GROUND_PATROL0" />
                    <IsAction value="ELEVATED_GROUND_PATROL1" />
                    <IsAction value="ELEVATED_GROUND_PATROL2" />
                    <IsAction value="ELEVATED_GROUND_PATROL3" />
                  </ReactiveFallback>
                  <SetAction action="ELEVATED_GROUND_PATROL3" />
                </Sequence>
                <SetAction action="OPERATOR_COMMAND" />
              </ReactiveFallback>
            </Sequence>

            <Sequence name="MaintainOperatorCommand">
              <IsAction value="OPERATOR_COMMAND" />
              <CompareValue key="operator_command_count" threshold="500" />
              <SetAction action="OPERATOR_COMMAND" />
            </Sequence>


            <ReactiveFallback name="PushActions">
              <Sequence name="StopWhenFindEnemy">
                <CheckVision key="vision.detected" expected="true" />
                <SetAction action="VISION" />
              </Sequence>

              <Sequence name="DefendHome">
                <CompareValue key="ref.ally_base_HP" threshold="1000" />
                <SetAction action="DEFEND_HOME" />
              </Sequence>

              <ReactiveFallback name="Attack">
                <Sequence name="AttackOutpost">
                 <!-- <前哨站血量判断> -->
                 <SetAction action="ATTACK_OUTPOST" />
                </Sequence>
                <ReactiveFallback name="Moving">
                  <Sequence name="ChaseEnemy">
                    <!-- <检查雷达数据> -->
                    <!-- <检查哨兵位置> -->
                    <SetAction action="CHASE_ENEMY" />
                  </Sequence>
                

                  <ReactiveFallback name="NormalActions">
                    <Sequence name="DefendRampLaunch">
                     <CheckIntStatus key="ref.launch_ramp_elevated_ground" expected="1" />
                     <SetAction action="DEFEND_RAMP_LAUNCH" />
                    </Sequence>

                    <!-- <Sequence name="AlignAtStair">
                      <IsAction value="DEFEND_RAMP_LAUNCH" />
                      <CheckArrived />
                      <SetAction action="BASE_ALIGN" />
                    </Sequence> -->

                    <Sequence name="GoUp">
                      <IsAction value="DEFEND_RAMP_LAUNCH" />
                      <CheckArrived />
                      <!-- <CompareYaw /> -->
                      <SetAction action="UPSTAIR" />
                    </Sequence>

                    <Sequence name="GoIntoElePatrol">
                      <IsAction value="UPSTAIR" />
                      <CheckArrived />
                      <SetAction action="ELEVATED_GROUND_PATROL0" />
                    </Sequence>

                    <Sequence name="ElevatedGroundPatrol">
                      <ReactiveFallback name="CheckElePatrol">
                        <IsAction value="ELEVATED_GROUND_PATROL0" />
                        <IsAction value="ELEVATED_GROUND_PATROL1" />
                        <IsAction value="ELEVATED_GROUND_PATROL2" />
                        <IsAction value="ELEVATED_GROUND_PATROL3" />
                      </ReactiveFallback>
                      <ReactiveFallback name="ExecuteElePatrol">
                        <Sequence name="ElevatedGroundPatrol1">
                          <IsAction value="ELEVATED_GROUND_PATROL0" />
                          <CheckArrived />
                          <SetAction action="ELEVATED_GROUND_PATROL1" />
                        </Sequence>

                        <Sequence name="ELEVATED_GROUND_PATROL2">
                          <IsAction value="ELEVATED_GROUND_PATROL1" />
                          <CheckArrived />
                        <SetAction action="ELEVATED_GROUND_PATROL2" />
                        </Sequence>

                        <Sequence name="ELEVATED_GROUND_PATROL3">
                          <IsAction value="ELEVATED_GROUND_PATROL2" />
                          <CheckArrived />
                        <SetAction action="ELEVATED_GROUND_PATROL3" />
                        </Sequence>
                      </ReactiveFallback>
                    </Sequence>

                    <Sequence name="DownStair">
                      <IsAction value="ELEVATED_GROUND_PATROLL0" />
                      <CheckArrived />
                      <SetAction action="DOWNSTAIR" />
                    </Sequence>

                  
                    <Sequence name="MaintainGoToStair">
                      <IsAction value="GOTOSTAIR" />
                      <SetAction action="GOTOSTAIR" />
                    </Sequence>

                    <Sequence name="MaintainBaseAlign">
                      <IsAction value="BASE_ALIGN" />
                      <SetAction action="BASE_ALIGN" />
                    </Sequence>

                    <Sequence name="MaintainUpstair">
                      <IsAction value="UPSTAIR" />
                      <SetAction action="UPSTAIR" />
                    </Sequence>

                    <Sequence name="MaintainDownstair">
                      <Inverter>
                        <CheckArrived />
                      </Inverter>
                      <IsAction value="DOWNSTAIR" />
                      <SetAction action="DOWNSTAIR" />
                    </Sequence>

                    <!-- Default state -->
                    <Sequence name="Patrol">
                      <SetAction action="PATROL" />
                    </Sequence>
                  </ReactiveFallback>
                </ReactiveFallback>
              </ReactiveFallback>
            </ReactiveFallback>
          </ReactiveFallback>
        </ReactiveFallback>
      </ReactiveFallback>

      <ReactiveFallback name="ExecuteAction">
        <Sequence>
          <IsAction value="INIT" />
          <PublishMotion />
          <ClearGoal />
        </Sequence>

        <Sequence>
          <ReactiveFallback>
            <IsAction value="RESPAWN" />
            <IsAction value="ELEDEAD" />
          </ReactiveFallback>
          <ClearGoal />
        </Sequence>

        <Sequence>
          <IsAction value="DEADSUPPLY" />
          <SetGoalFromParams ns="supply" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="SUPPLY" />
          <SetGoalFromParams ns="supply" />
          <ReactiveFallback name="MotionControl">
            <Sequence>
              <IntenseHarm threshold_activate="100" threshold_deactivate="50" />
              <SetMotionFlag target_motion="2" />
            </Sequence>
            <SetMotionFlag target_motion="3" />
          </ReactiveFallback>
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="GOTO_BUY" />
          <SetGoalFromParams ns="buy_bullet" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="BUY_BULLET" />
          <SetGoalFromParams ns="buy_bullet" />
          <SetMotionFlag target_motion="3" />
          <SetBulletNum mode="FIXED" fixed_supply="50" />
          <PublishMotion />
          <PublishGoalPoint topic="clicked_point" />
          <PublishBulletNum />
        </Sequence>

        <Sequence>
          <IsAction value="OPERATOR_COMMAND" />
          <!-- <读指令,publish/> -->
        </Sequence>

        <Sequence>
          <IsAction value="VISION" />
          <SetSpinFlag target_spin="4" />
          <ReactiveFallback name="MotionControl">
            <Sequence>
              <IntenseHarm threshold_activate="100" threshold_deactivate="50" />
              <SetMotionFlag target_motion="2" />
            </Sequence>
            <SetMotionFlag target_motion="1" />
          </ReactiveFallback>
          <PublishSpin />
        </Sequence>

        <Sequence>
          <IsAction value="DEFEND_HOME"/>
          <SetGoalFromParams ns="defend_home" />
          <PublishGoalPoint topic="clicked_point" />
        </Sequence>

        <Sequence>
          <IsAction value="ATTACK_OUTPOST"/>
          <SetGoalFromParams ns="attack_outpost" />
          <SetMotionFlag target_motion="1" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="CHASE_ENEMY"/>
          <SetGoalFromParams ns="chase_enemy" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="DEFEND_RAMP_LAUNCH" />
          <SetMotionFlag target_motion="3" />
          <SetGoalFromParams ns="defend_ramp_launch" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <!-- <Sequence name="ExecBaseAlign">
          <IsAction value="BASE_ALIGN" />
          <ResetNavArrived />
          
          <Fallback name="find_target">
            <Sequence>
              <Inverter>
                <CheckServerYawFlag />
              </Inverter>
              <FindAngle />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <CalculateAngle />
          <SetSpinFlag target_spin="1" />
          <CalculateAngle />
          <PublishSpin />
          <PublishTargetYaw />
        </Sequence> -->

        <Sequence name="ExecUpstair">
          <IsAction value="UPSTAIR" />
          <!-- <ResetServerYawFlag /> -->
          <SetGoalFromParams ns="upstair" />
          <SetSpinFlag target_spin="2" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishSpin />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="ELEVATED_GROUND_PATROL0"/>
          <SetGoalFromParams ns="elevated_ground_patrol0" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="ELEVATED_GROUND_PATROL1"/>
          <SetGoalFromParams ns="elevated_ground_patrol1" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="ELEVATED_GROUND_PATROL2"/>
          <SetGoalFromParams ns="elevated_ground_patrol2" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="ELEVATED_GROUND_PATROL3"/>
          <SetGoalFromParams ns="elevated_ground_patrol3" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>

        <Sequence>
          <IsAction value="DOWNSTAIR"/>
          <SetGoalFromParams ns="downstair" />
          <SetSpinFlag target_spin="3" />
          <SetMotionFlag target_motion="3" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishSpin />
          <PublishMotion />
        </Sequence>


        <Sequence>
          <IsAction value="PATROL" />
          <SetMotionFlag target_motion="3" />
          <Fallback>
            <Sequence>
              <CheckAttacked attack_threshold="{attack_threshold}" />
              <SetMotionFlag target_motion="2" />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <Fallback>
            <Sequence>
              <CheckArrived />
              <AdvanceCycleIndex ns="patrol" point_count="2" />
            </Sequence>
            <AlwaysSuccess />
          </Fallback>
          <SetGoalFromParamsCyclic ns="patrol" point_count="2" />
          <PublishGoalPoint topic="clicked_point" />
          <PublishMotion />
        </Sequence>
      </ReactiveFallback>

      <Sequence name="ResetValue">
        <Sequence name="FreeBullet">
          <!-- <CheckIntStatus key="ref.supplement" expected="1" /> -->
          <CheckVision key="ref.supplement" expected="true" />
          <SetBBValue key="count.free_bullet" type="int" value="0" />
        </Sequence>
        <Sequence name="Bullet">
          <Inverter>
            <IsAction value="BUY_BULLET" />
          </Inverter>
          <SetBBValue key="bullet_num" type="int" value="0" />
         <PublishBulletNum />
        </Sequence>
        <Sequence name="Spin">
          <Inverter>
            <ReactiveFallback>
              <IsAction value="UPSTAIR" />
              <!-- <IsAction value="BASE_ALIGN" /> -->
              <IsAction value="DOWNSTAIR" />
              <IsAction value="VISION" />
            </ReactiveFallback>
          </Inverter>
          <SetSpinFlag target_spin="0" />
          <PublishSpin />
        </Sequence>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>