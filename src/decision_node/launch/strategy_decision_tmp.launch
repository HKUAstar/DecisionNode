<launch>
  <!-- Temporary decision-only launch: runs strategy_node and publishes goals to /clicked_point.
       This launch does NOT start navigation/localization/referee bridges; it only outputs decision goals.
  -->

  <param name="use_sim_time" value="false"/>

  <!-- Tuning args -->
  <arg name="tick_hz" default="20"/>
  <arg name="danger_hp" default="200"/>
  <arg name="max_hp" default="400"/>
  <arg name="sufficient_bullet" default="150"/>
  <arg name="max_bullet" default="750"/>
  <arg name="fixed_supply" default="50"/>
  <arg name="publish_on_change_only" default="false"/>
  <arg name="attack_threshold" default="1"/>
  <arg name="harm_threshold_on" default="50"/>
  <arg name="harm_threshold_off" default="10"/>

  <!-- TF Calibration: 4 point pairs (raw_pts -> map_pts) for 2D rigid transform -->
  <arg name="tf_calib_src1_x" default="1"/>
  <arg name="tf_calib_src1_y" default="1"/>
  <arg name="tf_calib_tgt1_x" default="1"/>
  <arg name="tf_calib_tgt1_y" default="1"/>

  <arg name="tf_calib_src2_x" default="2"/>
  <arg name="tf_calib_src2_y" default="2"/>
  <arg name="tf_calib_tgt2_x" default="2"/>
  <arg name="tf_calib_tgt2_y" default="2"/>

  <arg name="tf_calib_src3_x" default="3"/>
  <arg name="tf_calib_src3_y" default="3"/>
  <arg name="tf_calib_tgt3_x" default="3"/>
  <arg name="tf_calib_tgt3_y" default="3"/>

  <arg name="tf_calib_src4_x" default="4"/>
  <arg name="tf_calib_src4_y" default="4"/>
  <arg name="tf_calib_tgt4_x" default="4"/>
  <arg name="tf_calib_tgt4_y" default="4"/>

  <!-- BehaviorTree XML -->
  <arg name="bt_xml" default=""/>
  <!-- <arg name="goal_yaml" default=""/> -->
  <arg name="goal_yaml" default=""/>

  <!-- Goal output topic (dstarlite.launch expects /clicked_point) -->
  <arg name="goal_topic" default="/clicked_point"/>


  <!-- 目标位姿四元数 - CalculateAngle节点使用 -->
  <param name="pose.pose.orientation.x" value="0.0"/>
  <param name="pose.pose.orientation.y" value="0.0"/>
  <param name="pose.pose.orientation.z" value="0.0"/>
  <param name="pose.pose.orientation.w" value="1.0"/>

  <node pkg="decision_node" type="strategy_node" name="strategy_node" output="screen" respawn="true">
    <!-- private params (pnh: ~) -->
    <param name="tick_hz" value="$(arg tick_hz)"/>
    <param name="danger_hp" value="$(arg danger_hp)"/>
    <param name="max_hp" value="$(arg max_hp)"/>
    <param name="sufficient_bullet" value="$(arg sufficient_bullet)"/>
    <param name="max_bullet" value="$(arg max_bullet)"/>
    <param name="fixed_supply" value="$(arg fixed_supply)"/>
    <param name="publish_on_change_only" value="$(arg publish_on_change_only)"/>
    <param name="attack_threshold" value="$(arg attack_threshold)"/>
    <param name="harm_threshold_on" value="$(arg harm_threshold_on)"/>
    <param name="harm_threshold_off" value="$(arg harm_threshold_off)"/>
    <param name="bt_xml" value="$(arg bt_xml)"/>
    <!-- Goal YAML: 目标点坐标数据文件 -->
    <param name="goal_yaml" value="$(arg goal_yaml)"/>

    <!-- TF Calibration params -->
    <param name="tf_calib/src_pt1_x" value="$(arg tf_calib_src1_x)"/>
    <param name="tf_calib/src_pt1_y" value="$(arg tf_calib_src1_y)"/>
    <param name="tf_calib/tgt_pt1_x" value="$(arg tf_calib_tgt1_x)"/>
    <param name="tf_calib/tgt_pt1_y" value="$(arg tf_calib_tgt1_y)"/>

    <param name="tf_calib/src_pt2_x" value="$(arg tf_calib_src2_x)"/>
    <param name="tf_calib/src_pt2_y" value="$(arg tf_calib_src2_y)"/>
    <param name="tf_calib/tgt_pt2_x" value="$(arg tf_calib_tgt2_x)"/>
    <param name="tf_calib/tgt_pt2_y" value="$(arg tf_calib_tgt2_y)"/>

    <param name="tf_calib/src_pt3_x" value="$(arg tf_calib_src3_x)"/>
    <param name="tf_calib/src_pt3_y" value="$(arg tf_calib_src3_y)"/>
    <param name="tf_calib/tgt_pt3_x" value="$(arg tf_calib_tgt3_x)"/>
    <param name="tf_calib/tgt_pt3_y" value="$(arg tf_calib_tgt3_y)"/>

    <param name="tf_calib/src_pt4_x" value="$(arg tf_calib_src4_x)"/>
    <param name="tf_calib/src_pt4_y" value="$(arg tf_calib_src4_y)"/>
    <param name="tf_calib/tgt_pt4_x" value="$(arg tf_calib_tgt4_x)"/>
    <param name="tf_calib/tgt_pt4_y" value="$(arg tf_calib_tgt4_y)"/>

    <!-- Remap node-relative clicked_point -> desired global goal topic -->
    <remap from="clicked_point" to="$(arg goal_topic)"/>
  </node>
</launch>
