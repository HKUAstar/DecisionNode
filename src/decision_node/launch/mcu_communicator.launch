<?xml version="1.0"?>
<!--
  跨包包含: 在其他包的 launch 文件中
     <include file="$(find decision_node)/launch/mcu_communicator_can.launch">
       <arg name="can_interface" value="can0" />
       <arg name="nav_frequency" value="50" />
     </include>
-->

<launch>
  <!-- 参数声明 -->
  <arg name="can_interface" default="can0" doc="CAN 接口名称 (can0, can1 等)" />
  <arg name="nav_frequency" default="50" doc="导航数据发布频率 (Hz)" />
  
  <!-- MCU CAN 通讯节点 -->
  <node name="mcu_communicator" pkg="decision_node" type="mcu_communicator_can" output="screen">
    <!-- CAN 接口配置 -->
    <param name="can_interface" value="$(arg can_interface)" />
    
    <!-- 导航数据发布频率 (Hz) -->
    <param name="nav_frequency" value="$(arg nav_frequency)" />
    
    <!-- 话题重映射
    <remap from="/cmd_vel" to="/robot/cmd_vel" />
    -->
  </node>
  
</launch>
