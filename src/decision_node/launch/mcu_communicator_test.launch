<?xml version="1.0" encoding="UTF-8"?>
<!-- 虚拟串口 -->
<launch>  
    <!-- 虚拟串口测试配置 (注释掉) -->
    <arg name="simulator_port" default="/dev/pts/12" doc="Virtual serial port for simulator"/>
    <arg name="communicator_port" default="/dev/pts/11" doc="Virtual serial port for communicator"/>
    <arg name="bullet_num" default="10" doc="Bullet number to send"/> 
    
    <!-- MCU模拟器 - 生成测试数据 (注释掉) -->
    <node name="mcu_simulator" pkg="decision_node" type="mcu_simulator" output="$(arg output)">
        <param name="serial_port" value="$(arg simulator_port)" />
        <param name="baudrate" value="$(arg baudrate)" />
    </node> 
    
</launch>