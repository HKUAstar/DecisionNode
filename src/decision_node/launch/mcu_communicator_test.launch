<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- 虚拟串口测试配置 -->
    <arg name="simulator_port" default="/dev/pts/12" doc="Virtual serial port for simulator"/>
    <arg name="communicator_port" default="/dev/pts/11" doc="Virtual serial port for communicator"/>
    <arg name="baudrate" default="115200" doc="Serial port baudrate"/>
    <arg name="output" default="screen" doc="Launch output target"/>
    
    <!-- MCU通讯节点 -->
    <node name="mcu_communicator" pkg="decision_node" type="mcu_communicator" output="$(arg output)">
        <!-- 虚拟串口配置 -->
        <param name="serial_port" value="$(arg communicator_port)" />
        <param name="baudrate" value="$(arg baudrate)" />
    </node>
    
    <!-- MCU模拟器 - 生成测试数据 -->
    <node name="mcu_simulator" pkg="decision_node" type="mcu_simulator" output="$(arg output)">
        <!-- 虚拟串口配置 -->
        <param name="serial_port" value="$(arg simulator_port)" />
        <param name="baudrate" value="$(arg baudrate)" />
    </node>
    
</launch>